diff --git a/Source/Teensy/WriteSnoop.h b/Source/Teensy/WriteSnoop.h
new file mode 100644
index 0000000..0555a91
--- /dev/null
+++ b/Source/Teensy/WriteSnoop.h
@@ -0,0 +1,26 @@
+// teensyrom-snoop: the phi2-ISR half.  Included by Teensy.ino just before MinimalBoot/Common/ISRs.c
+// (main image only: FeatWriteSnoop is defined in TeensyROM.h).
+//
+// isrPHI2 calls SnoopTap() on a C64 write whose page is in the map:
+//    if (!R_Wn && SnoopHot.page[Address >> 8]) SnoopTap(Address);
+// That test is the whole cost on every other cycle (one byte load from DTCM on a write, nothing on a
+// read).  SnoopTap waits for the data bus (nS_DataSetup after phi2 rise, as every IO1/IO2 write
+// handler does), so only watched writes pay that wait.
+#ifdef FeatWriteSnoop
+
+#define SnoopToken 0x6453   // 'd' 'S': start / stop / status, see docs/PROTOCOL.md
+
+#define SNOOP_COLD FLASHMEM
+#include "snoop/snoop.h"
+
+snoop_hot_t SnoopHot;             // plain global: DTCM, the ISR's fast RAM (~4.9 KB)
+DMAMEM snoop_t SnoopState;        // the main loop's half: RAM2 (~9 KB)
+Stream *SnoopOut = NULL;          // the channel that started the run
+
+FASTRUN __attribute__((noinline)) void SnoopTap(uint16_t Address)
+{
+   if (!snoop_isr_match(&SnoopHot, Address)) return;
+   snoop_isr_store(&SnoopHot, Address, DataPortWaitRead(), StartCycCnt);
+}
+
+#endif
diff --git a/Source/Teensy/WriteSnoop.ino b/Source/Teensy/WriteSnoop.ino
new file mode 100644
index 0000000..bedff7c
--- /dev/null
+++ b/Source/Teensy/WriteSnoop.ino
@@ -0,0 +1,434 @@
+// teensyrom-snoop: the main-loop half.  Command 0x6453 from the USB serial or TCP channel, and
+// SnoopService() from loop().  Protocol: docs/PROTOCOL.md in teensyrom-snoop.
+
+#ifdef FeatWriteSnoop
+
+#include "snoop/snoop.c"
+
+bool SnoopReady = false;
+bool SnoopDtrAtStart = false;   // a USB serial run whose host had DTR up: stop when it drops (port closed)
+
+// Sending in batches.  Every USB transfer the Teensy core starts (schedule_transfer in usb.c) runs with
+// all interrupts off, the phi2 ISR included, and a small write starts one of its own.  Streaming in small
+// pieces (~500 transfers/s) made cartridge games glitch or crash (Ms. Pac-Man) while TCP was fine.  So the
+// output goes out at most every SnoopSendEveryMs (20 on USB serial unless the start command asks for
+// another value; 0 = at once, TCP's default), or when SnoopBatchBytes are waiting, in as few writes as
+// the channel takes.
+//
+// On TCP (from 0.9-sn3) the default is Nagle's rule, as upstream's SwiftLink Tx (PR #80): send at once while
+// nothing sent earlier is unacknowledged (availableForWrite() back at the full socket size), otherwise collect
+// until 1 KB or SnoopTcpMaxMs.  A fast LAN keeps near-zero latency; a slow link (multi-hop WiFi) gets fewer,
+// larger segments instead of one small one every ~2 ms.  A send interval in the start command replaces the rule.
+#define SnoopUsbDefaultMs  20
+#define SnoopTcpMaxMs      20
+#define SnoopBatchBytes    1024
+bool SnoopNagle = false;
+uint32_t SnoopSendEveryMs = 0;
+uint32_t SnoopLastSendMs = 0;
+DMAMEM uint8_t SnoopTxBuf[2048];   // one USB serial transmit buffer (TX_SIZE) per write
+
+// CPU probe (0.9-sn6), for phase 2 (docs/USB-AUDIO.md): while a capture runs, every SnoopProbeEveryMs the loop
+// spins for SnoopProbeUs on the cycle counter, and snoop_cpu_probe counts the gaps the interrupts took.  The share
+// left goes out in STATUS (protocol 4).  It holds up loop() for that 1 ms, 1% of the time.
+#define SnoopProbeEveryMs  100
+#define SnoopProbeUs       1000
+#ifndef SnoopCycles
+#define SnoopCycles() ARM_DWT_CYCCNT
+#endif
+uint32_t SnoopLastProbeMs = 0;
+FLASHMEM uint32_t SnoopReadCycles() { return SnoopCycles(); }
+
+#ifdef FeatTCPListen
+// The data port (0.9-sn4).  A client connects to SnoopDataPort and sends the same commands there; the stream
+// goes back on that connection, so the TeensyROM's own port (2112) stays free for other tools (trls, trvdrive,
+// file transfers) during a capture.  A start on 2112 or USB serial still works as before.
+// NativeEthernet's EthernetServer::available() listens on first call, and hands over a client only once it has
+// sent something, waiting up to 10 s for that: a client must send its command right after connecting.
+#define SnoopDataPort 6581
+EthernetServer SnoopServer(SnoopDataPort);
+EthernetClient SnoopClient;
+#endif
+
+FLASHMEM void SnoopSetup()
+{
+   if (SnoopReady) return;
+   snoop_init(&SnoopState, &SnoopHot);
+   SnoopReady = true;
+}
+
+FLASHMEM uint32_t SnoopPhi2Hz()
+{
+   return (IO1[wRegVid_TOD_Clks] & rvtcNTSC) ? 1022727 : 985248;
+}
+
+// The SID emulator (0.9-sn7, phase 2 step 2, docs/USB-AUDIO.md): only in a tree that has reSID in src/reSID/
+// (tools/fetch_resid.py; GPL-2.0-or-later, so such an image is GPL as a whole).  One 6581 at 48 kHz, fast
+// sampling, clocked to each captured write to $D400-$D41F on its exact C64 cycle and then to "now" on every
+// loop pass.  The output goes nowhere yet: this step measures the cost, which STATUS (protocol 5) reports as
+// emu_cyc (CPU cycles taken, interrupts included) for emu_c64 (C64 cycles emulated).
+#if !defined(SNOOP_RESID_H) && defined(__has_include)
+#if __has_include("src/reSID/sid.h")
+#define SNOOP_RESID_H "src/reSID/sid.h"
+#endif
+#endif
+#ifdef SNOOP_RESID_H
+#include SNOOP_RESID_H
+#define SnoopSidBase    0xD400
+#define SnoopSidRate    48000
+reSID::SID *SnoopSid = NULL;               // on the heap (RAM2): its filter tables are 16 KB
+uint64_t SnoopSidAt = 0;                   // C64 cycles emulated this run
+DMAMEM short SnoopSidBuf[256];
+void (*SnoopSidSink)(const short *Samples, int n) = NULL;   // where the samples go (the host test only, for now)
+
+FLASHMEM void SnoopSidClockTo(uint64_t Time)
+{
+   if (SnoopSid == NULL || Time <= SnoopSidAt) return;
+   const uint64_t Span = Time - SnoopSidAt;
+   const uint32_t Start = SnoopCycles();
+   uint64_t Left = Span;
+   while (Left)
+   {
+      reSID::cycle_count d = Left > 0x40000000u ? 0x40000000 : (reSID::cycle_count)Left;
+      Left -= (uint64_t)d;
+      while (d > 0)
+      {
+         const int n = SnoopSid->clock(d, SnoopSidBuf, (int)(sizeof SnoopSidBuf / sizeof SnoopSidBuf[0]));
+         if (SnoopSidSink && n > 0) SnoopSidSink(SnoopSidBuf, n);
+      }
+   }
+   SnoopState.emu_cyc += SnoopCycles() - Start;
+   SnoopState.emu_c64 += (uint32_t)Span;
+   SnoopSidAt = Time;
+}
+
+FLASHMEM void SnoopSidWrite(void *, uint64_t Time, uint16_t Address, uint8_t Data)
+{
+   if ((uint16_t)(Address - SnoopSidBase) >= 0x20) return;
+   SnoopSidClockTo(Time);
+   SnoopSid->write(Address & 0x1F, Data);
+}
+
+FLASHMEM void SnoopSidStart()
+{
+   if (SnoopSid == NULL) SnoopSid = new reSID::SID();
+   SnoopSid->set_chip_model(reSID::MOS6581);
+   SnoopSid->set_sampling_parameters(SnoopPhi2Hz(), reSID::SAMPLE_FAST, SnoopSidRate);
+   SnoopSid->reset();
+   SnoopSidAt = 0;
+   SnoopState.on_write = SnoopSidWrite;
+   SnoopState.on_write_ctx = NULL;
+}
+#endif
+
+// Send what the FIFO holds, never more than the channel takes without blocking
+// (EthernetClient::write busy-waits for buffer space; USB serial waits for the host).
+FLASHMEM void SnoopSend(Stream *Out)
+{
+   while (snoop_out_avail(&SnoopState))
+   {
+      int Room = Out->availableForWrite();
+      if (Room <= 0) return;
+      uint32_t n = snoop_out_take(&SnoopState, SnoopTxBuf, Room < (int)sizeof SnoopTxBuf ? (uint32_t)Room : sizeof SnoopTxBuf);
+      Out->write(SnoopTxBuf, n);
+   }
+}
+
+// Give a stopped run's last frames (STATUS, BYE) to their channel, for up to TimeoutmS
+FLASHMEM void SnoopFlushTo(Stream *Out, uint32_t TimeoutmS)
+{
+   const uint32_t Start = millis();
+   while (Out != NULL && snoop_out_avail(&SnoopState) && millis() - Start < TimeoutmS) SnoopSend(Out);
+   SnoopState.out_tail = SnoopState.out_head;   // whatever is left (channel gone or too slow) is dropped
+}
+
+FLASHMEM bool SnoopGetByte(uint8_t *b)
+{
+   uint32_t v;
+   if (!GetUInt(&v, 1)) return false;   // GetUInt sends FailToken + "Timeout!" itself
+   *b = (uint8_t)v;
+   return true;
+}
+
+// The USB audio dongle on the host port (0.9-sn8, phase 2 step 3, docs/USB-AUDIO.md).  USBAudioOut (in
+// src/USBHost_t36, with isochronous OUT added to ehci.cpp) claims a USB Audio Class 1 device that takes 16-bit
+// stereo at 48 kHz, and streams whatever SnoopAudioFill gives it: 48 stereo frames (192 bytes) every 1 ms frame,
+// asked for in the USBHS interrupt (below phi2's priority) a few frames ahead.  The source is silence, or the
+// 1 kHz test tone that command 64 53 03 switches.  Phase 2 step 4 makes reSID the source: 1 ms of the snoop
+// timeline per frame, which runs on the same crystal as the USB frames, so no rate matching is needed.
+#ifndef SNOOP_AUDIO_STUB   // tests/fw_host brings a stand-in
+#include "src/USBHost_t36/USBAudioOut.h"
+#else
+#include "src/USBHost_t36/isoaudio.h"
+#endif
+#define SnoopAudioRate  48000
+#define SnoopToneHz     1000
+#define SnoopToneAmp    8192     // -12 dBFS
+isoaudio_tone_t SnoopTone;
+// The sample source: Frames stereo frames, 16-bit little endian, to Packet.  NULL: silence.  Runs in the USBHS
+// interrupt, so it must not block; swap it by storing a new pointer (one aligned word).
+typedef void (*SnoopAudioSourceFn)(uint8_t *Packet, uint32_t Frames);
+volatile SnoopAudioSourceFn SnoopAudioSource = NULL;
+
+FLASHMEM void SnoopToneSource(uint8_t *Packet, uint32_t Frames)
+{
+   isoaudio_tone_packet(&SnoopTone, Packet, Frames);
+}
+
+FLASHMEM void SnoopAudioFill(void *, uint8_t *Packet, uint32_t Len)
+{
+   const SnoopAudioSourceFn Source = SnoopAudioSource;
+   if (Source) Source(Packet, Len / 4);
+   else memset(Packet, 0, Len);
+}
+
+USBAudioOut SnoopDongle(myusbHost, SnoopAudioFill);   // a USBHost_t36 driver: waits for a device on the host port
+
+// One line: the source, and what the dongle is doing.  The strings stay in flash (PSTR): RAM1 is scarce.
+FLASHMEM const char *SnoopAudioStep(uint8_t Step)
+{
+   switch (Step)
+   {
+   case 1: return PSTR("SET_INTERFACE");
+   case 2: return PSTR("SET_CUR rate");
+   case 3: return PSTR("GET_MIN volume");
+   case 4: return PSTR("GET_MAX volume");
+   case 5: return PSTR("SET_CUR volume");
+   case 6: return PSTR("SET_CUR mute");
+   default: return PSTR("?");
+   }
+}
+
+// A USB Audio volume (1/256 dB) as dB with one decimal, to Out
+FLASHMEM void SnoopAudioDb(Stream *Out, int16_t V)
+{
+   const int32_t Tenths = ((int32_t)V * 10 + (V < 0 ? -128 : 128)) / 256;   // rounded half away from zero
+   const int32_t A = Tenths < 0 ? -Tenths : Tenths;
+   Out->printf(PSTR("%s%ld.%ld"), Tenths < 0 ? PSTR("-") : PSTR(""), (long)(A / 10), (long)(A % 10));
+}
+
+FLASHMEM void SnoopAudioReport(Stream *Out)
+{
+   USBAudioOut::Info i;
+   SnoopDongle.info(&i);
+   Out->printf(PSTR("Snoop audio: %s; "), SnoopAudioSource == SnoopToneSource ? PSTR("tone 1000 Hz") : PSTR("silence"));
+   if (!i.attached)
+   {
+      Out->printf(PSTR("no USB audio device%s\n"),
+                  i.last_reject == ISOAUDIO_NO_FORMAT ? PSTR(" (one was offered: no 16-bit stereo 48 kHz)") :
+                  i.last_reject == ISOAUDIO_ASYNC ? PSTR(" (one was offered: asynchronous, not supported)") :
+                  i.last_reject == ISOAUDIO_SMALL ? PSTR(" (one was offered: packets too small)") : PSTR(""));
+      return;
+   }
+   Out->printf(PSTR("%04X:%04X interface %u alt %u ep %02X, %s; frames %lu, errors %lu, missed %lu"),
+               i.vid, i.pid, i.iface, i.alt, i.ep,
+               i.streaming ? PSTR("streaming") : i.step < 0 ? PSTR("failed") : PSTR("starting"),
+               (unsigned long)i.iso.frames, (unsigned long)i.iso.errors, (unsigned long)i.iso.missed);
+   if (i.iso.errors) Out->printf(PSTR(" (last siTD status %02lX)"), (unsigned long)i.iso.status);
+   if (i.fu)
+   {
+      Out->printf(PSTR("; volume "));
+      SnoopAudioDb(Out, i.volume);
+      Out->printf(PSTR(" dB ("));
+      SnoopAudioDb(Out, i.vol_min);
+      Out->printf(PSTR(".."));
+      SnoopAudioDb(Out, i.vol_max);
+      Out->printf(PSTR(")%s"), i.unmuted ? PSTR(", unmuted") : PSTR(""));
+   }
+   else Out->printf(PSTR("; no feature unit"));
+   if (i.failed_step) Out->printf(PSTR("; %s failed"), SnoopAudioStep(i.failed_step));
+   Out->printf(PSTR("\n"));
+}
+
+// 64 53 03 mode: 0 silence, 1 the test tone, 2 only report
+FLASHMEM void SnoopAudioCommand()
+{
+   uint8_t Mode;
+   if (!SnoopGetByte(&Mode)) return;
+   if (Mode > 2)
+   {
+      SendU16(FailToken);
+      CmdChannel->printf(PSTR("Snoop audio: mode 0 silence, 1 tone, 2 report\n"));
+      return;
+   }
+   if (Mode == 0) SnoopAudioSource = NULL;
+   if (Mode == 1 && SnoopAudioSource != SnoopToneSource)
+   {
+      isoaudio_tone_init(&SnoopTone, SnoopToneHz, SnoopAudioRate, SnoopToneAmp);
+      SNOOP_BARRIER();   // the tone is ready before the interrupt can see the pointer
+      SnoopAudioSource = SnoopToneSource;
+   }
+   SendU16(AckToken);
+   SnoopAudioReport(CmdChannel);
+}
+
+// 0x64 0x53, then: 0 stop | 1 start n {first lo,hi, last lo,hi}*n gap flags | 2 status | 3 audio mode
+FLASHMEM void SnoopCommand()
+{
+   SnoopSetup();
+   uint8_t Op;
+   if (!SnoopGetByte(&Op)) return;
+
+   if (Op == 0)
+   {
+      SendU16(AckToken);
+      if (SnoopState.running)
+      {
+         snoop_stop(&SnoopState, SNOOP_BYE_STOPPED, micros(), ARM_DWT_CYCCNT);
+         SnoopFlushTo(SnoopOut, 200);
+      }
+      SnoopOut = NULL;
+      return;
+   }
+   if (Op == 2)
+   {
+      SendU16(AckToken);
+      if (SnoopState.running) snoop_status(&SnoopState);
+      return;
+   }
+   if (Op == 3)
+   {
+      SnoopAudioCommand();
+      return;
+   }
+   if (Op != 1)
+   {
+      SendU16(FailToken);
+      CmdChannel->println("Snoop: unknown op");
+      return;
+   }
+
+   uint8_t N, Gap, Flags, b[4];
+   if (!SnoopGetByte(&N)) return;
+   if (N == 0 || N > SNOOP_MAX_RANGES)
+   {
+      SendU16(FailToken);
+      CmdChannel->printf("Snoop: 1-%d ranges\n", SNOOP_MAX_RANGES);
+      return;
+   }
+   snoop_range_t Ranges[SNOOP_MAX_RANGES];
+   for (uint8_t i = 0; i < N; i++)
+   {
+      for (uint8_t k = 0; k < 4; k++) if (!SnoopGetByte(&b[k])) return;
+      Ranges[i].first = (uint16_t)(b[0] | b[1] << 8);
+      Ranges[i].last  = (uint16_t)(b[2] | b[3] << 8);
+   }
+   if (!SnoopGetByte(&Gap) || !SnoopGetByte(&Flags)) return;   // Flags: send interval in ms, 0 = the channel's default
+
+   int Res = snoop_check(Ranges, N);   // before anything stops: a refused start leaves a running capture alone
+   if (Res == 0)
+   {
+      if (SnoopState.running && SnoopOut != CmdChannel)
+      {  // a start from another channel: the old one gets its BYE first
+         snoop_stop(&SnoopState, SNOOP_BYE_REPLACED, micros(), ARM_DWT_CYCCNT);
+         SnoopFlushTo(SnoopOut, 200);
+      }
+      Res = snoop_start(&SnoopState, Ranges, N, Gap, SnoopPhi2Hz(), F_CPU_ACTUAL, micros(), ARM_DWT_CYCCNT);
+   }
+   if (Res != 0)
+   {
+      SendU16(FailToken);
+      if (Res == -2) CmdChannel->println("Snoop: range first > last");
+      else if (Res == -3) CmdChannel->printf("Snoop: more than %d pages (256-byte) watched\n", SNOOP_POOL_PAGES);
+      else CmdChannel->println("Snoop: bad ranges");
+      return;
+   }
+   SendU16(AckToken);     // before HELLO, which the next SnoopService() sends
+   SnoopOut = CmdChannel;
+   // Only a host that raised DTR can be seen closing the port (pyserial raises it; some
+   // serial libraries leave it down by default, and then the run goes on until stopped).
+   SnoopDtrAtStart = (SnoopOut == (Stream *)&Serial) && Serial.dtr();
+   SnoopSendEveryMs = Flags ? Flags : (SnoopOut == (Stream *)&Serial ? SnoopUsbDefaultMs : SnoopTcpMaxMs);
+#ifdef FeatTCPListen
+   SnoopNagle = !Flags && (SnoopOut == (Stream *)&tcpClient || SnoopOut == (Stream *)&SnoopClient);
+#endif
+   SnoopLastSendMs = millis();
+   SnoopLastProbeMs = SnoopLastSendMs - SnoopProbeEveryMs;   // the first probe on the next pass
+#ifdef SNOOP_RESID_H
+   SnoopSidStart();
+#endif
+}
+
+#ifdef FeatTCPListen
+// The data port: accept a client, run the commands it sends (the same 0x64 0x53 ... as on 2112), drop it when
+// it goes.  CmdChannel points at it while a command runs, so SnoopCommand() reads and answers there.
+FLASHMEM void SnoopDataPortService()
+{
+   if (!NetListenEnable) return;   // Ethernet not up (the TeensyROM's own port is not listening either)
+   if (!SnoopClient) SnoopClient = SnoopServer.available();
+   if (!SnoopClient) return;
+   if (!SnoopClient.connected())
+   {
+      if (SnoopOut == (Stream *)&SnoopClient)
+      {
+         snoop_stop(&SnoopState, SNOOP_BYE_CHANNEL, micros(), ARM_DWT_CYCCNT);
+         SnoopFlushTo(NULL, 0);
+         SnoopOut = NULL;
+      }
+      SnoopClient.stop();
+      return;
+   }
+   while (SnoopClient.available())
+   {
+      if (SnoopClient.peek() != 0x64) { SnoopClient.read(); continue; }   // anything but a command lead is ignored
+      if (SnoopClient.available() < 2) break;            // the token byte on a later pass (GetUInt waits for the rest)
+      SnoopClient.read();
+      Stream *Was = CmdChannel;
+      CmdChannel = &SnoopClient;
+      if (SnoopClient.read() == (SnoopToken & 0xFF)) SnoopCommand();
+      else
+      {
+         SendU16(FailToken);
+         CmdChannel->println("Snoop data port: only the snoop command (0x64 0x53)");
+      }
+      CmdChannel = Was;
+   }
+}
+#endif
+
+// From loop(), every pass.
+FLASHMEM void SnoopService()
+{
+#ifdef FeatTCPListen
+   SnoopDataPortService();
+#endif
+   if (!SnoopReady || SnoopOut == NULL) return;
+#ifdef FeatTCPListen
+   if ((SnoopOut == (Stream *)&tcpClient && !tcpClient.connected()) ||
+       (SnoopOut == (Stream *)&SnoopClient && !SnoopClient.connected()))
+   {
+      snoop_stop(&SnoopState, SNOOP_BYE_CHANNEL, micros(), ARM_DWT_CYCCNT);
+      SnoopFlushTo(NULL, 0);
+      SnoopOut = NULL;
+      return;
+   }
+#endif
+   if (SnoopOut == (Stream *)&Serial && SnoopDtrAtStart && !Serial.dtr())
+   {  // the host closed the port: nobody is reading
+      snoop_stop(&SnoopState, SNOOP_BYE_CHANNEL, micros(), ARM_DWT_CYCCNT);
+      SnoopFlushTo(NULL, 0);
+      SnoopOut = NULL;
+      return;
+   }
+   snoop_poll(&SnoopState, micros(), ARM_DWT_CYCCNT);
+#ifdef SNOOP_RESID_H
+   SnoopSidClockTo(SnoopState.c64_time);
+#endif
+   const uint32_t Now = millis();
+   if (Now - SnoopLastProbeMs >= SnoopProbeEveryMs)
+   {
+      SnoopLastProbeMs = Now;
+      snoop_cpu_probe(&SnoopState, SnoopReadCycles, (uint32_t)((uint64_t)F_CPU_ACTUAL * SnoopProbeUs / 1000000u));
+   }
+   const uint32_t Avail = snoop_out_avail(&SnoopState);
+   bool Due = Avail && (Avail >= SnoopBatchBytes || Now - SnoopLastSendMs >= SnoopSendEveryMs);
+#ifdef FeatTCPListen
+   if (Avail && !Due && SnoopNagle) Due = SnoopOut->availableForWrite() >= FNET_SOCKET_DEFAULT_SIZE;   // nothing in flight
+#endif
+   if (Due)
+   {
+      SnoopSend(SnoopOut);
+      SnoopLastSendMs = Now;
+   }
+}
+
+#endif
diff --git a/Source/Teensy/snoop/snoop.c b/Source/Teensy/snoop/snoop.c
new file mode 100644
index 0000000..b722004
--- /dev/null
+++ b/Source/Teensy/snoop/snoop.c
@@ -0,0 +1,363 @@
+/* teensyrom-snoop: main-loop side.  See snoop.h and docs/PROTOCOL.md. */
+#include "snoop.h"
+#include <string.h>
+
+#ifndef SNOOP_COLD
+#define SNOOP_COLD   /* the firmware puts these in flash (FLASHMEM) */
+#endif
+
+/* ---- helpers -------------------------------------------------------------------------------- */
+
+SNOOP_COLD uint16_t snoop_crc16(const uint8_t *p, size_t n)
+{
+   uint16_t crc = 0xFFFF;
+   while (n--)
+   {
+      crc ^= (uint16_t)(*p++) << 8;
+      for (int i = 0; i < 8; i++) crc = (crc & 0x8000) ? (uint16_t)((crc << 1) ^ 0x1021) : (uint16_t)(crc << 1);
+   }
+   return crc;
+}
+
+SNOOP_COLD size_t snoop_cobs_encode(const uint8_t *in, size_t n, uint8_t *out)
+{
+   size_t o = 1, code_at = 0;
+   uint8_t code = 1;
+   for (size_t i = 0; i < n; i++)
+   {
+      if (in[i] == 0)
+      {
+         out[code_at] = code;
+         code_at = o++;
+         code = 1;
+      }
+      else
+      {
+         out[o++] = in[i];
+         if (++code == 0xFF)
+         {
+            out[code_at] = code;
+            code_at = o++;
+            code = 1;
+         }
+      }
+   }
+   out[code_at] = code;
+   return o;
+}
+
+static SNOOP_COLD size_t put_varint(uint8_t *p, uint64_t v)
+{
+   size_t n = 0;
+   do
+   {
+      uint8_t b = (uint8_t)(v & 0x7F);
+      v >>= 7;
+      p[n++] = (uint8_t)(b | (v ? 0x80 : 0));
+   } while (v);
+   return n;
+}
+
+static SNOOP_COLD size_t put_u16(uint8_t *p, uint16_t v) { p[0] = (uint8_t)v; p[1] = (uint8_t)(v >> 8); return 2; }
+static SNOOP_COLD size_t put_u32(uint8_t *p, uint32_t v)
+{
+   p[0] = (uint8_t)v; p[1] = (uint8_t)(v >> 8); p[2] = (uint8_t)(v >> 16); p[3] = (uint8_t)(v >> 24);
+   return 4;
+}
+
+/* ---- output FIFO ---------------------------------------------------------------------------- */
+
+static SNOOP_COLD uint32_t out_used(const snoop_t *s) { return (s->out_head - s->out_tail) & (SNOOP_OUT_SIZE - 1); }
+static SNOOP_COLD uint32_t out_free(const snoop_t *s) { return SNOOP_OUT_SIZE - 1 - out_used(s); }
+
+SNOOP_COLD uint32_t snoop_out_avail(const snoop_t *s) { return out_used(s); }
+
+SNOOP_COLD uint32_t snoop_out_take(snoop_t *s, uint8_t *dst, uint32_t max)
+{
+   uint32_t n = 0;
+   while (n < max && s->out_tail != s->out_head)
+   {
+      dst[n++] = s->out[s->out_tail];
+      s->out_tail = (s->out_tail + 1) & (SNOOP_OUT_SIZE - 1);
+   }
+   return n;
+}
+
+/* Frame a payload: CRC-16 appended, COBS, 0x00 delimiters on both sides.  A frame that does not fit is dropped
+ * whole (counted), so the stream never carries a cut frame. */
+static SNOOP_COLD void emit(snoop_t *s, const uint8_t *payload, size_t n)
+{
+   uint8_t raw[SNOOP_FRAME_MAX + 2];
+   uint8_t enc[SNOOP_FRAME_MAX + 2 + (SNOOP_FRAME_MAX + 2) / 254 + 2];
+   memcpy(raw, payload, n);
+   const uint16_t crc = snoop_crc16(payload, n);
+   raw[n] = (uint8_t)crc;
+   raw[n + 1] = (uint8_t)(crc >> 8);
+   const size_t e = snoop_cobs_encode(raw, n + 2, enc);
+   if (out_free(s) < e + 2) { s->out_dropped++; return; }
+   s->out[s->out_head] = 0;   /* a delimiter before as well: text the TR printed since cannot spoil this frame */
+   s->out_head = (s->out_head + 1) & (SNOOP_OUT_SIZE - 1);
+   for (size_t i = 0; i < e; i++)
+   {
+      s->out[s->out_head] = enc[i];
+      s->out_head = (s->out_head + 1) & (SNOOP_OUT_SIZE - 1);
+   }
+   s->out[s->out_head] = 0;
+   s->out_head = (s->out_head + 1) & (SNOOP_OUT_SIZE - 1);
+}
+
+/* ---- WRITES frames -------------------------------------------------------------------------- */
+
+static SNOOP_COLD void frame_close(snoop_t *s)
+{
+   if (!s->len_at) return;     /* no block: nothing to send */
+   emit(s, s->frame, s->flen);
+   s->len_at = 0;
+   s->flen = 0;
+}
+
+/* Header of a new WRITES frame: type, seq, t0 (absolute time of its first block). */
+static SNOOP_COLD void frame_open(snoop_t *s, uint64_t t0, uint32_t now_us)
+{
+   s->flen = 0;
+   s->frame[s->flen++] = SNOOP_F_WRITES;
+   s->flen += (uint16_t)put_u16(s->frame + s->flen, s->seq++);
+   s->flen += (uint16_t)put_varint(s->frame + s->flen, t0);
+   s->prev_block = t0;
+   s->frame_born_us = now_us;
+}
+
+#define BLOCK_HEAD_MAX (10 + 2 + 1)   /* dt varint, addr, len */
+
+static SNOOP_COLD void add_write(snoop_t *s, uint16_t addr, uint8_t data, uint64_t t, uint32_t now_us)
+{
+   if (s->len_at)
+   {
+      uint8_t *len = &s->frame[s->len_at];
+      if (addr == (uint16_t)(s->block_addr + *len) && *len < 255 &&
+          t - s->last_write <= s->max_gap && s->flen < SNOOP_FRAME_MAX)
+      {
+         s->frame[s->flen++] = data;
+         (*len)++;
+         s->last_write = t;
+         return;
+      }
+      if (s->flen + BLOCK_HEAD_MAX + 1 > SNOOP_FRAME_MAX) frame_close(s);
+   }
+   if (!s->len_at) frame_open(s, t, now_us);
+   s->flen += (uint16_t)put_varint(s->frame + s->flen, t - s->prev_block);
+   s->flen += (uint16_t)put_u16(s->frame + s->flen, addr);
+   s->len_at = s->flen;
+   s->frame[s->flen++] = 1;
+   s->frame[s->flen++] = data;
+   s->block_addr = addr;
+   s->block_time = s->last_write = s->prev_block = t;
+}
+
+/* ---- time ----------------------------------------------------------------------------------- */
+
+static SNOOP_COLD void advance(snoop_t *s, uint32_t stamp)
+{
+   const uint32_t d = stamp - s->last_stamp;
+   if ((int32_t)d <= 0) return;   /* a late-entry stamp a little behind the base: same time */
+   const uint64_t num = (uint64_t)d * s->phi2_hz + s->rem;
+   s->c64_time += num / s->cpu_hz;
+   s->rem = num % s->cpu_hz;
+   s->last_stamp = stamp;
+}
+
+/* ---- control -------------------------------------------------------------------------------- */
+
+SNOOP_COLD void snoop_init(snoop_t *s, snoop_hot_t *hot)
+{
+   memset(hot, 0, sizeof *hot);
+   memset(s, 0, sizeof *s);
+   s->hot = hot;
+   s->flush_us = 2000;
+   s->status_ms = 1000;
+   s->probe_worst = 1000;
+}
+
+SNOOP_COLD uint32_t snoop_cpu_probe(snoop_t *s, uint32_t (*cyc)(void), uint32_t window_cyc)
+{
+   const uint32_t start = cyc();
+   uint32_t prev = start, stolen = 0, longest = 0, now;
+   do
+   {
+      now = cyc();
+      const uint32_t d = now - prev;
+      if (d > SNOOP_PROBE_STALL)
+      {
+         stolen += d;
+         if (d > longest) longest = d;
+      }
+      prev = now;
+   } while (now - start < window_cyc);
+   const uint32_t total = now - start;
+   if (total == 0) return 0;   /* window 0 and a counter that did not move */
+   const uint32_t free_cyc = total - stolen;
+   const uint32_t permille = (uint32_t)((uint64_t)free_cyc * 1000u / total);
+   s->probe_cyc += total;
+   s->probe_free += free_cyc;
+   if (permille < s->probe_worst) s->probe_worst = (uint16_t)permille;
+   if (longest > s->probe_stall) s->probe_stall = longest;
+   return free_cyc;
+}
+
+SNOOP_COLD void snoop_status(snoop_t *s)
+{
+   uint8_t p[1 + 2 + 10 + 4 + 4 + 2 + 4 + 3 * 4 + 4 + 4 + 2 + 4 + 4 + 4];
+   size_t n = 0;
+   frame_close(s);
+   p[n++] = SNOOP_F_STATUS;
+   n += put_u16(p + n, s->seq);              /* next WRITES seq: the host sees frames lost at the tail too */
+   n += put_varint(p + n, s->c64_time);
+   n += put_u32(p + n, s->hot->dropped);
+   n += put_u32(p + n, s->out_dropped);
+   n += put_u16(p + n, (uint16_t)(s->ring_hiwater > 0xFFFF ? 0xFFFF : s->ring_hiwater));
+   n += put_u32(p + n, s->writes);
+   for (int i = 0; i < 3; i++) n += put_u32(p + n, s->hot->late[i]);
+   n += put_u32(p + n, s->probe_cyc);
+   n += put_u32(p + n, s->probe_free);
+   n += put_u16(p + n, s->probe_worst);
+   n += put_u32(p + n, s->probe_stall);
+   n += put_u32(p + n, s->emu_cyc);
+   n += put_u32(p + n, s->emu_c64);
+   emit(s, p, n);
+   s->emu_cyc = s->emu_c64 = 0;
+   s->ring_hiwater = 0;
+   s->probe_cyc = s->probe_free = s->probe_stall = 0;
+   s->probe_worst = 1000;
+}
+
+/* Page map for the ranges; 0 or an error (see snoop_start). */
+static SNOOP_COLD int build_pmap(const snoop_range_t *ranges, uint8_t nranges, uint8_t pmap[256])
+{
+   if (nranges == 0 || nranges > SNOOP_MAX_RANGES) return -1;
+   for (uint8_t i = 0; i < nranges; i++) if (ranges[i].first > ranges[i].last) return -2;
+   uint8_t npages = 0;
+   memset(pmap, 0, 256);
+   for (uint8_t i = 0; i < nranges; i++)
+      for (uint32_t pg = ranges[i].first >> 8; pg <= (uint32_t)(ranges[i].last >> 8); pg++)
+         if (!pmap[pg])
+         {
+            if (npages == SNOOP_POOL_PAGES) return -3;
+            pmap[pg] = ++npages;
+         }
+   return 0;
+}
+
+SNOOP_COLD int snoop_check(const snoop_range_t *ranges, uint8_t nranges)
+{
+   uint8_t pmap[256];
+   return build_pmap(ranges, nranges, pmap);
+}
+
+SNOOP_COLD int snoop_start(snoop_t *s, const snoop_range_t *ranges, uint8_t nranges, uint8_t max_gap,
+                           uint32_t phi2_hz, uint32_t cpu_hz, uint32_t now_us, uint32_t now_stamp)
+{
+   /* checks first, so a refused start leaves a running capture alone */
+   uint8_t pmap[256];
+   const int err = build_pmap(ranges, nranges, pmap);
+   if (err) return err;
+   if (phi2_hz == 0 || cpu_hz == 0) return -1;
+
+   if (s->running) snoop_stop(s, SNOOP_BYE_REPLACED, now_us, now_stamp);
+
+   snoop_hot_t *hot = s->hot;
+   memset(hot->page, 0, sizeof hot->page);    /* the ISR is idle from here (it already was) */
+   memset(hot->bits, 0, sizeof hot->bits);
+   hot->head = hot->tail = 0;
+   hot->dropped = 0;
+   hot->late[0] = hot->late[1] = hot->late[2] = 0;
+   {  /* one phi2 period, plus ~250 ns / ~1 us */
+      const uint64_t period = (uint64_t)cpu_hz / phi2_hz;
+      hot->late_cyc[0] = (uint32_t)(period + (uint64_t)cpu_hz / 4000000u);
+      hot->late_cyc[1] = (uint32_t)(period + (uint64_t)cpu_hz / 1000000u);
+   }
+
+   memcpy(s->ranges, ranges, nranges * sizeof *ranges);
+   s->nranges = nranges;
+   s->max_gap = max_gap;
+   s->phi2_hz = phi2_hz;
+   s->cpu_hz = cpu_hz;
+   s->last_stamp = now_stamp;
+   s->c64_time = 0;
+   s->rem = cpu_hz / 2;                       /* round to the nearest cycle */
+   s->flen = 0;
+   s->len_at = 0;
+   s->seq = 0;
+   s->out_dropped = 0;
+   s->ring_hiwater = 0;
+   s->writes = 0;
+   s->probe_cyc = s->probe_free = s->probe_stall = 0;
+   s->probe_worst = 1000;
+   s->emu_cyc = s->emu_c64 = 0;
+   s->last_status_us = now_us;
+
+   uint8_t p[1 + 1 + 4 + 4 + 1 + 1 + 4 * SNOOP_MAX_RANGES];
+   size_t n = 0;
+   p[n++] = SNOOP_F_HELLO;
+   p[n++] = SNOOP_PROTO_VERSION;
+   n += put_u32(p + n, phi2_hz);
+   n += put_u32(p + n, cpu_hz);
+   p[n++] = max_gap;
+   p[n++] = nranges;
+   for (uint8_t i = 0; i < nranges; i++)
+   {
+      n += put_u16(p + n, ranges[i].first);
+      n += put_u16(p + n, ranges[i].last);
+   }
+   emit(s, p, n);
+
+   for (uint8_t i = 0; i < nranges; i++)
+      for (uint32_t a = ranges[i].first; a <= ranges[i].last; a++)
+         hot->bits[pmap[a >> 8] - 1][(a & 0xFF) >> 5] |= 1u << (a & 31);
+   s->running = 1;
+   memcpy(hot->page, pmap, sizeof pmap);      /* last: arms the ISR */
+   return 0;
+}
+
+SNOOP_COLD uint32_t snoop_poll(snoop_t *s, uint32_t now_us, uint32_t now_stamp)
+{
+   if (!s->running) return 0;
+   snoop_hot_t *hot = s->hot;
+   uint32_t taken = 0;
+   uint32_t tail = hot->tail;
+   const uint32_t head = hot->head;
+   SNOOP_BARRIER();          /* no entry is read before head */
+   const uint32_t used = (head - tail) & (SNOOP_RING - 1);
+   if (used > s->ring_hiwater) s->ring_hiwater = used;
+   while (tail != head)
+   {
+      const snoop_ev_t e = hot->ring[tail];
+      tail = (tail + 1) & (SNOOP_RING - 1);
+      SNOOP_BARRIER();            /* the entry is copied before its slot is handed back */
+      hot->tail = tail;
+      advance(s, e.stamp);
+      add_write(s, e.addr, e.data, s->c64_time, now_us);
+      if (s->on_write) s->on_write(s->on_write_ctx, s->c64_time, e.addr, e.data);
+      taken++;
+   }
+   s->writes += taken;
+   advance(s, now_stamp);
+
+   if (s->len_at && (uint32_t)(now_us - s->frame_born_us) >= s->flush_us) frame_close(s);
+   if (s->status_ms && (uint32_t)(now_us - s->last_status_us) >= (uint32_t)s->status_ms * 1000u)
+   {
+      s->last_status_us = now_us;
+      snoop_status(s);
+   }
+   return taken;
+}
+
+SNOOP_COLD void snoop_stop(snoop_t *s, uint8_t reason, uint32_t now_us, uint32_t now_stamp)
+{
+   if (!s->running) return;
+   memset(s->hot->page, 0, sizeof s->hot->page);   /* first: the ISR stops adding */
+   snoop_poll(s, now_us, now_stamp);                /* what it already added */
+   s->running = 0;
+   snoop_status(s);
+   uint8_t p[2] = { SNOOP_F_BYE, reason };
+   emit(s, p, sizeof p);
+}
diff --git a/Source/Teensy/snoop/snoop.h b/Source/Teensy/snoop/snoop.h
new file mode 100644
index 0000000..07cde91
--- /dev/null
+++ b/Source/Teensy/snoop/snoop.h
@@ -0,0 +1,237 @@
+/* teensyrom-snoop: capture C64 bus writes to chosen addresses and stream them.
+ *
+ * Portable C99, also compiled as C++ by the TeensyROM firmware (keep it C++-clean).
+ *
+ * Two halves:
+ *   - the ISR side (snoop_hot_t, snoop_isr_match / snoop_isr_store): a two-level address filter and
+ *     a single-producer ring of {stamp, address, data}.  This is all the phi2 interrupt touches;
+ *     keep it small and in fast RAM (DTCM on the Teensy).
+ *   - the main-loop side (snoop_t, snoop_poll): drains the ring, converts CPU-clock stamps to C64
+ *     cycles, groups writes to consecutive addresses into blocks {dt, addr, len, bytes} and frames
+ *     them (COBS + CRC-16) into an output FIFO that the glue sends without blocking.
+ *
+ * Wire format: docs/PROTOCOL.md.
+ */
+#ifndef SNOOP_H
+#define SNOOP_H
+
+#include <stdint.h>
+#include <stddef.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define SNOOP_PROTO_VERSION 6
+
+#ifndef SNOOP_MAX_RANGES
+#define SNOOP_MAX_RANGES   16     /* address ranges per start command */
+#endif
+#ifndef SNOOP_POOL_PAGES
+#define SNOOP_POOL_PAGES   16     /* distinct 256-byte pages that may hold watched addresses */
+#endif
+#ifndef SNOOP_RING
+#define SNOOP_RING         512    /* ISR ring entries, power of two (8 bytes each) */
+#endif
+#ifndef SNOOP_FRAME_MAX
+#define SNOOP_FRAME_MAX    512    /* largest frame payload before COBS/CRC */
+#endif
+#ifndef SNOOP_OUT_SIZE
+#define SNOOP_OUT_SIZE     8192   /* output FIFO (framed bytes waiting for the channel), power of two */
+#endif
+
+#ifndef SNOOP_PROBE_STALL
+#define SNOOP_PROBE_STALL  40     /* CPU cycles: a gap between two counter reads longer than this is an interrupt */
+#endif
+
+#if (SNOOP_RING & (SNOOP_RING - 1)) != 0 || (SNOOP_OUT_SIZE & (SNOOP_OUT_SIZE - 1)) != 0
+#error "SNOOP_RING and SNOOP_OUT_SIZE must be powers of two"
+#endif
+
+/* frame types (first payload byte) */
+enum {
+   SNOOP_F_HELLO  = 0x01,
+   SNOOP_F_WRITES = 0x02,
+   SNOOP_F_STATUS = 0x03,
+   SNOOP_F_BYE    = 0x04
+};
+
+/* BYE reasons */
+enum {
+   SNOOP_BYE_STOPPED  = 0,   /* stop command */
+   SNOOP_BYE_REPLACED = 1,   /* a new start command took over */
+   SNOOP_BYE_CHANNEL  = 2    /* the channel went away (glue decides) */
+};
+
+typedef struct {
+   uint32_t stamp;   /* CPU cycle counter at phi2 rise */
+   uint16_t addr;
+   uint8_t  data;
+   uint8_t  pad;
+} snoop_ev_t;
+
+typedef struct {
+   uint16_t first, last;   /* inclusive */
+} snoop_range_t;
+
+/* Everything the phi2 ISR touches. */
+typedef struct {
+   uint8_t           page[256];                      /* 0: page not watched, else 1 + pool index */
+   uint32_t          bits[SNOOP_POOL_PAGES][8];      /* one bit per address in the page */
+   volatile uint32_t head;                           /* written by the ISR only */
+   volatile uint32_t tail;                           /* written by the main loop only */
+   volatile uint32_t dropped;                        /* ISR: ring full */
+   volatile uint32_t late[3];                        /* late phi2 interrupts: any, > ~250 ns, > ~1 us (an edge missed) */
+   uint32_t          late_cyc[2];                    /* CPU cycles between two interrupts above which late[1] / late[2] count */
+   snoop_ev_t        ring[SNOOP_RING];
+} snoop_hot_t;
+
+/* Compiler barrier.  The ISR and the main loop share one core, so no CPU fence is needed, but the
+ * compiler may move the plain ring accesses across the volatile head/tail ones (GCC 13 did put the
+ * entry's stores after the head store in SnoopTap). */
+#if defined(__GNUC__) || defined(__clang__)
+#define SNOOP_BARRIER() __asm__ __volatile__("" ::: "memory")
+#else
+#define SNOOP_BARRIER() do {} while (0)
+#endif
+
+/* ---- ISR side ------------------------------------------------------------------------------- */
+
+/* Second-level test, after the caller saw hot->page[addr >> 8] != 0. */
+static inline int snoop_isr_match(const snoop_hot_t *hot, uint16_t addr)
+{
+   const uint8_t p = hot->page[addr >> 8];
+   if (!p) return 0;
+   return (hot->bits[p - 1][(addr & 0xff) >> 5] >> (addr & 31)) & 1u;
+}
+
+/* isrPHI2's "late" branch (an interrupt more than nS_MaxAdj after the previous one) calls this with
+ * the CPU cycles since the previous interrupt: a diagnostic of what else holds the bus interrupt up
+ * (interrupts switched off by a USB transfer, a long ISR, ...).  Counts from the start command. */
+static inline void snoop_isr_late(snoop_hot_t *hot, uint32_t cyc_since_last)
+{
+   hot->late[0]++;
+   if (cyc_since_last > hot->late_cyc[0])
+   {
+      hot->late[1]++;
+      if (cyc_since_last > hot->late_cyc[1]) hot->late[2]++;
+   }
+}
+
+static inline void snoop_isr_store(snoop_hot_t *hot, uint16_t addr, uint8_t data, uint32_t stamp)
+{
+   const uint32_t h = hot->head;
+   const uint32_t next = (h + 1) & (SNOOP_RING - 1);
+   if (next == hot->tail) { hot->dropped++; return; }
+   snoop_ev_t *e = &hot->ring[h];
+   e->stamp = stamp;
+   e->addr = addr;
+   e->data = data;
+   SNOOP_BARRIER();          /* the entry is complete before head says so */
+   hot->head = next;
+}
+
+/* ---- main-loop side ------------------------------------------------------------------------- */
+
+typedef struct {
+   snoop_hot_t   *hot;
+   int            running;
+
+   /* configuration of the current run */
+   snoop_range_t  ranges[SNOOP_MAX_RANGES];
+   uint8_t        nranges;
+   uint8_t        max_gap;        /* C64 cycles: a write joins the open block when within this of the previous one */
+   uint32_t       phi2_hz;        /* C64 clock used for stamp conversion */
+   uint32_t       cpu_hz;         /* stamp clock */
+   uint16_t       flush_us;       /* send a non-empty WRITES frame after this long */
+   uint16_t       status_ms;      /* STATUS frame period, 0 = only on request/stop */
+
+   /* time conversion */
+   uint32_t       last_stamp;
+   uint64_t       c64_time;       /* C64 cycles since the start */
+   uint64_t       rem;            /* remainder of the stamp -> cycle division, in cpu_hz units */
+   int            have_stamp;
+
+   /* WRITES frame being built (payload only) */
+   uint8_t        frame[SNOOP_FRAME_MAX];
+   uint16_t       flen;
+   uint16_t       seq;
+   uint64_t       block_time;     /* time of the open block's first write */
+   uint64_t       last_write;     /* time of the open block's last write */
+   uint64_t       prev_block;     /* time of the previous block in this frame (dt base) */
+   uint16_t       block_addr;
+   uint16_t       len_at;         /* frame offset of the open block's length byte, 0 = no open block */
+   uint32_t       frame_born_us;
+
+   /* statistics */
+   uint32_t       dropped_seen;   /* hot->dropped at the last STATUS */
+   uint32_t       out_dropped;    /* frames lost because the output FIFO was full */
+   uint32_t       ring_hiwater;
+   uint32_t       last_status_us;
+   uint32_t       writes;
+
+   /* CPU probe (snoop_cpu_probe), since the last STATUS */
+   uint32_t       probe_cyc;      /* CPU cycles spent probing */
+   uint32_t       probe_free;     /* ...of which the main loop had (no interrupt running) */
+   uint16_t       probe_worst;    /* lowest free share of a single probe, per mille (1000 = no probe yet) */
+   uint32_t       probe_stall;    /* longest single interruption, CPU cycles */
+
+   /* A consumer of the writes (phase 2: an emulator on the Teensy).  snoop_poll calls on_write for every
+    * captured write, in order, with its exact C64 time; snoop_init clears it, snoop_start leaves it.  The glue
+    * adds what the consumer cost to emu_cyc / emu_c64, which the next STATUS reports and clears (version 5). */
+   void         (*on_write)(void *ctx, uint64_t time, uint16_t addr, uint8_t data);
+   void          *on_write_ctx;
+   uint32_t       emu_cyc;        /* CPU cycles the consumer took (wall time: interrupts included) */
+   uint32_t       emu_c64;        /* C64 cycles it emulated */
+
+   /* output FIFO */
+   uint8_t        out[SNOOP_OUT_SIZE];
+   uint32_t       out_head, out_tail;
+} snoop_t;
+
+/* Clear everything; hot is the ISR's block (may live elsewhere in memory). */
+void snoop_init(snoop_t *s, snoop_hot_t *hot);
+
+/* Start a run.  Returns 0, or a negative error:
+ *   -1 bad range count, -2 a range with first > last, -3 more than SNOOP_POOL_PAGES pages.
+ * The ISR sees nothing until the page map is written, which is done last; a run already going
+ * is stopped first (BYE REPLACED).  now_us is the glue's microsecond clock. */
+int  snoop_start(snoop_t *s, const snoop_range_t *ranges, uint8_t nranges, uint8_t max_gap,
+                 uint32_t phi2_hz, uint32_t cpu_hz, uint32_t now_us, uint32_t now_stamp);
+
+/* The checks snoop_start makes on the ranges, without touching anything: 0 or its error code. */
+int  snoop_check(const snoop_range_t *ranges, uint8_t nranges);
+
+/* Stop capturing (page map cleared first), drain what the ring holds, send STATUS and BYE. */
+void snoop_stop(snoop_t *s, uint8_t reason, uint32_t now_us, uint32_t now_stamp);
+
+/* Main loop: drain the ring, close frames that are full or older than flush_us, STATUS on its
+ * period.  now_stamp is the stamp clock read BEFORE the call (so every event already in the ring
+ * is no later than it, give or take the ISR's late-entry adjustment, which is clamped); the time
+ * base moves up to it even with no writes, so a long quiet spell cannot wrap the 32-bit stamp.
+ * The glue must call it at least every 2^31 stamp ticks (3.5 s at 600 MHz).
+ * Returns the number of events taken. */
+uint32_t snoop_poll(snoop_t *s, uint32_t now_us, uint32_t now_stamp);
+
+/* CPU probe, for phase 2 (an emulator in the main loop): how much of the CPU the interrupts leave.
+ * Spins for window_cyc CPU cycles reading the cycle counter through cyc(); every gap between two reads
+ * longer than SNOOP_PROBE_STALL is time an interrupt took (isrPHI2 above all).  Interrupts shorter than
+ * that count as free, so the result is an upper bound.  Adds to the next STATUS; returns the free cycles.
+ * Blocks the caller for the window: the glue runs it briefly and seldom (1 ms every 100 ms). */
+uint32_t snoop_cpu_probe(snoop_t *s, uint32_t (*cyc)(void), uint32_t window_cyc);
+
+/* Queue a STATUS frame now (closes the open WRITES frame first). */
+void snoop_status(snoop_t *s);
+
+/* Output FIFO: bytes ready, and taking them. */
+uint32_t snoop_out_avail(const snoop_t *s);
+uint32_t snoop_out_take(snoop_t *s, uint8_t *dst, uint32_t max);
+
+/* Helpers, exposed for tests and the host side. */
+uint16_t snoop_crc16(const uint8_t *p, size_t n);          /* CRC-16/CCITT-FALSE */
+size_t   snoop_cobs_encode(const uint8_t *in, size_t n, uint8_t *out);  /* out >= n + n/254 + 1 */
+
+#ifdef __cplusplus
+}
+#endif
+#endif
