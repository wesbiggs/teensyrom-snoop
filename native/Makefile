# trsid-native: the SID player in C++ on classic reSID, for computers too slow for trsid.py (a Raspberry Pi Zero).
#
#   make -C native            # fetches reSID (git), builds ../build/native/trsid-native
#   make -C native RESID=/path/to/resid    # an existing reSID checkout instead
#
# reSID (GPL-2.0-or-later) is fetched at build time at a fixed commit, not kept in this repository.
# Needs: g++ (or clang++), git, perl (reSID's wave tables are generated by its own Perl script).

CXX       ?= c++
CXXFLAGS  ?= -O2
WARN      := -Wall -Wextra
B         := ../build/native
RESID_URL ?= https://github.com/libsidplayfp/resid
RESID_REV ?= 3bf8eff22bc81743d2d5fa089eaf2414bf3ed6e4
RESID     ?= $(B)/resid-src
# 1: reSID 1.0's newer 8580 filter (filter8580new.cc, as VICE builds it); 0: the original filter.cc
NEW8580   ?= 1

ifeq ($(NEW8580),1)
FILTER_SRC := filter8580new.cc
else
FILTER_SRC := filter.cc
endif
RESID_SRCS := sid.cc voice.cc wave.cc envelope.cc $(FILTER_SRC) dac.cc extfilt.cc pot.cc version.cc
WAVES      := wave6581_PST wave6581_PS_ wave6581_P_T wave6581__ST wave8580_PST wave8580_PS_ wave8580_P_T wave8580__ST
GEN        := $(B)/gen$(NEW8580)
OBJS       := $(RESID_SRCS:%.cc=$(GEN)/%.o)

all: $(B)/trsid-native

$(B)/resid-src/sid.cc:
	mkdir -p $(B)
	rm -rf $(B)/resid-src
	git clone -q $(RESID_URL) $(B)/resid-src
	git -C $(B)/resid-src checkout -q $(RESID_REV)

$(GEN)/siddefs.h: $(RESID)/sid.cc
	mkdir -p $(GEN)
	sed -e 's/@RESID_INLINING@/1/' -e 's/@RESID_INLINE@/inline/' -e 's/@RESID_BRANCH_HINTS@/1/' \
	    -e 's/@NEW_8580_FILTER@/$(NEW8580)/' -e 's/@HAVE_BOOL@/1/' -e 's/@HAVE_BUILTIN_EXPECT@/1/' \
	    -e 's/@HAVE_LOG1P@/1/' $(RESID)/siddefs.h.in > $@
	for w in $(WAVES); do perl $(RESID)/samp2src.pl $$w $(RESID)/$$w.dat $(GEN)/$$w.h || exit 1; done

$(GEN)/%.o: $(GEN)/siddefs.h
	$(CXX) $(CXXFLAGS) -w -DVERSION='"1.0"' -I$(GEN) -I$(RESID) -c -o $@ $(RESID)/$*.cc

$(B)/trsid-native: trsid.cpp $(OBJS)
	$(CXX) $(CXXFLAGS) $(WARN) -std=c++11 -I$(GEN) -I$(RESID) -o $@ trsid.cpp $(OBJS)

clean:
	rm -rf $(B)/gen0 $(B)/gen1 $(B)/trsid-native

.PHONY: all clean
